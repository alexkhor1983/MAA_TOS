{
    "$__mpe_config_GetReward": {
        "$__mpe_code": {
            "prefix": "",
            "filename": "GetReward",
            "version": "v0.7.0"
        }
    },
    "GetReward_Start": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "doc": "處理月卡與簽到彈窗，或在主畫面可用時直接開啟側邊欄",
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "[JumpBack]PopupHandler_CloseCross",
            "GetReward_CloseCross",
            "GetReward_SignInReward",
            "GetReward_Confirm",
            "GetReward_OpenSideBar"
        ],
        "timeout": 15000,
        "on_error": [
            "GetReward_MonthlyPassDone"
        ]
    },
    "GetReward_CloseCross": {
        "recognition": {
            "type": "FeatureMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    720,
                    1280
                ],
                "template": [
                    "PopupHandler_CloseCross.png",
                    "GetReward_MonthlyPassCross.png"
                ],
                "count": 4
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 1500,
        "timeout": 8000,
        "doc": "全螢幕 FeatureMatch 動態定位圓形或月禮包方形叉號按鈕並點擊；命中後繼續掃描其他彈窗",
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "[JumpBack]PopupHandler_CloseCross",
            "GetReward_CloseCross",
            "GetReward_SignInReward",
            "GetReward_Confirm",
            "GetReward_OpenSideBar"
        ],
        "on_error": [
            "GetReward_MonthlyPassDone"
        ]
    },
    "GetReward_SignInReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    300,
                    720,
                    300
                ],
                "expected": [
                    "簽到獎賞",
                    "签到奖赏",
                    "簽到獎勵",
                    "签到奖励",
                    "簽到",
                    "签到"
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "post_delay": 500,
        "doc": "辨識簽到獎賞/签到奖励文字，導向確定按鈕點擊",
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "[JumpBack]PopupHandler_CloseCross",
            "GetReward_Confirm",
            "GetReward_OpenSideBar"
        ],
        "on_error": [
            "GetReward_MonthlyPassDone"
        ]
    },
    "GetReward_Confirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    600,
                    720,
                    500
                ],
                "expected": ["確定", "确定"],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 1500,
        "timeout": 5000,
        "doc": "辨識並點擊確定按鈕",
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "[JumpBack]PopupHandler_CloseCross",
            "GetReward_CloseCross",
            "GetReward_SignInReward",
            "GetReward_Confirm",
            "GetReward_OpenSideBar"
        ],
        "on_error": [
            "GetReward_MonthlyPassDone"
        ]
    },
    "GetReward_MonthlyPassDone": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "doc": "月卡與簽到獎勵處理完畢，開始領取獎賞頁面的額外獎勵",
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "GetReward_OpenSideBar"
