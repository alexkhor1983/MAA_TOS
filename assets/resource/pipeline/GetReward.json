                "expected": ["確定", "确定"],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 750,
        "next": [
            "[JumpBack]PopupHandler_AccountRiskTitle",
            "[JumpBack]PopupHandler_BonusStageText",
            "GetReward_Done"
