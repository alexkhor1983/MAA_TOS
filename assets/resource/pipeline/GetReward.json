        "on_error": ["GetReward_Done"],
        "doc": "關閉自動領取後的獎賞確認彈窗"
    },
    "GetReward_AutoCollectComplete": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    720,
                    1280
                ],
                "expected": [
                    "自動領取",
                    "自动领取"
                ],
                "threshold": 0.3
            }
        },
        "inverse": true,
        "action": {
            "type": "DoNothing",
            "param": {}
