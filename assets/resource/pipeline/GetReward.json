        "timeout": 8000,
        "on_error": [
            "GetReward_Done"
        ]
    },
    "GetReward_OpenSideBar": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    620,
                    0,
                    100,
                    120
                ],
                "template": "GetReward_OpenSideBar_720.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
